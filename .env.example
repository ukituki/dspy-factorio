# Copy to .env and fill in real values.
# cp .env.example .env

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPEN_ROUTER_API_KEY=
GEMINI_API_KEY=

# Optional: point FLE at a known Factorio RCON endpoint
# (skips Docker container discovery — useful when Docker is flaky)
# FACTORIO_SERVER_ADDRESS=127.0.0.1
# FACTORIO_SERVER_PORT=27000

FLE_DB_TYPE=sqlite
SQLITE_DB_FILE=.fle/data.db
